<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">咖啡因</string>
    <string name="xposed_description">专为 OxygenOS / ColorOS 打造的 LineageOS 咖啡因快捷图块，支持动态倒计时与多挡位常亮。</string>
    <string name="tile_caffeine">咖啡因</string>
    <string name="tile_state_off">关闭</string>
    <string name="tile_state_infinite">∞</string>
    
    <!-- Status Card -->
    <string name="status_module_unavailable">模块服务不可用</string>
    <string name="status_module_unavailable_desc">请在兼容 libxposed 的模块管理器中启用本模块</string>
    <string name="status_scope_missing">SystemUI 不在作用域中</string>
    <string name="status_scope_missing_desc">请将“系统界面 (SystemUI)”加入作用域，然后重启 SystemUI</string>
    <string name="status_hook_unavailable">SystemUI Hook 未生效</string>
    <string name="status_hook_checking_desc">正在检查 SystemUI Hook 是否在线…</string>
    <string name="status_hook_unavailable_desc">启用或更新模块后，请重启 SystemUI</string>
    
    <!-- Control Card -->
    <string name="control_title">快捷测试与控制</string>
    <string name="control_desc">点击循环切换常量亮屏时间或关闭咖啡因</string>
    <string name="btn_toggle">切换状态</string>
    
    <!-- Preferences -->
    <string name="pref_category_behavior">行为偏好设置</string>
    <string name="pref_screen_off_title">息屏或锁屏时自动关闭</string>
    <string name="pref_screen_off_desc">当按电源键熄灭屏幕或放入口袋时自动释放亮屏锁（LineageOS 标准行为）</string>
    
    <string name="pref_haptic_title">触觉震动反馈</string>
    <string name="pref_haptic_desc">每次点击快捷图块切换状态时产生轻微触感震动</string>

    <string name="pref_durations_title">循环时间序列</string>
    <string name="pref_durations_desc">点击循环阶梯：5分钟 → 10分钟 → 30分钟 → 1小时 → 无限常亮(∞) → 关闭</string>
    
    <!-- Help / Setup -->
    <string name="help_title">OxygenOS 使用与配置指引</string>
    <string name="help_step1">1. 在 Xposed 模块管理器中激活本模块，作用域只需勾选“系统界面 (SystemUI)”。</string>
    <string name="help_step2">2. 下拉通知栏控制中心，点击右上角编辑（铅笔）图标，将“咖啡因”图块拖入常用区域。</string>
    <string name="help_step3">3. 点击图块即可轮流切换常亮时长 (5m → 10m → 30m → 1h → ∞ → 关闭)，标题将实时显示倒计时！</string>
    <string name="btn_add_qs_tile">直接添加图块到控制中心</string>
    <string name="tile_added_success">已向系统发起添加图块请求！</string>
    <string name="notification_channel_name">咖啡因保持常亮通知</string>
    <string name="notification_title">咖啡因正在保持屏幕常亮</string>
    <string name="notification_text">剩余时间：%s</string>
</resources>
